<%
// Geometry for the signal trace. Everything is measured in months; CSS turns
// months into length with --xp-month, so the axis stays true to the dates.
// Wave units equal desktop pixels; the SVG scales uniformly to the month height.
const UNITS_PER_MONTH = 18;
const WAVE_WIDTH = 56;
const roles = [...experience].sort((a, b) => a.startMonth - b.startMonth);

const seedOf = (text) =>
    [...text].reduce((h, c) => Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0, 2166136261);

// Deterministic speech-like oscillation: a carrier under a slowly varying
// envelope, tapered to the flat line at both ends.
const wavePath = (months, seed, current) => {
    const cycles = current ? 1.6 : 0.8;
    const amplitude = current ? 22 : 17;
    const phase = [0, 1, 2].map((i) => ((seed >>> (i * 9)) % 997) / 997 * Math.PI * 2);
    const step = 1 / (cycles * 12);
    const points = [];
    for (let t = 0; t <= months + step / 2; t += step) {
        const m = Math.min(t, months);
        const taper = Math.min(1, m / 0.6, (months - m) / 0.6);
        const envelope = 0.6 + 0.4 * Math.sin(m / 1.7 + phase[1]) * Math.sin(m / 0.9 + phase[2]);
        const x = WAVE_WIDTH / 2 + amplitude * taper * envelope * Math.sin(Math.PI * 2 * cycles * m + phase[0]);
        points.push(`${x.toFixed(1)} ${(m * UNITS_PER_MONTH).toFixed(1)}`);
    }
    return `M${points.join('L')}`;
};

const yearsIn = (from, to) => {
    const years = [];
    for (let year = Math.ceil(from / 12); year * 12 < to; year += 1) years.push({ year, at: year * 12 - from });
    return years;
};

const gapLabel = (months) => {
    const whole = Math.round(months);
    if (whole < 2) return '';
    const years = Math.floor(whole / 12);
    const rest = whole % 12;
    const parts = [];
    if (years) parts.push(`${years} ${years === 1 ? 'year' : 'years'}`);
    if (rest) parts.push(`${rest} months`);
    return parts.join(', ');
};

const fmt = (n) => +n.toFixed(3);
%>
<section id="experience" class="xp wrap" aria-labelledby="experience-title">
    <h2 id="experience-title" class="heading-section">Experience</h2>

    <% if (roles.length === 0) { %>
        <p class="mt-8 max-w-[62ch] text-lg">My work history is not listed here yet, so <a class="text-ultra underline" href="<%= profile.links.linkedin %>" target="_blank" rel="noopener">read it on LinkedIn</a>.</p>
    <% } else {
        const axisStart = Math.floor(roles[0].startMonth / 12) * 12;
        const present = Math.max(...roles.map((r) => r.endMonth));
        const lead = roles[0].startMonth - axisStart;
    %>
    <div class="xp-timeline">
        <% if (lead > 0) { %>
            <div class="xp-lead" style="--xp-span: <%= fmt(lead) %>" aria-hidden="true">
                <% yearsIn(axisStart, roles[0].startMonth).forEach(function (tick) { %>
                    <span class="xp-tick" style="--xp-at: <%= fmt(tick.at) %>"><%= tick.year %></span>
                <% }); %>
                <span class="xp-flat" data-xp-draw style="--xp-len: <%= fmt(lead) %>"></span>
            </div>
        <% } %>

        <ol class="xp-list">
            <% roles.forEach(function (role, index) {
                const next = roles[index + 1];
                const until = next ? next.startMonth : present;
                const active = Math.max(Math.min(role.endMonth, until) - role.startMonth, 0.5);
                const gap = Math.max(until - role.startMonth - active, 0);
                const label = next ? gapLabel(gap) : '';
            %>
                <li id="<%= role.id %>" class="xp-role<%= role.current ? ' is-current' : '' %><%= next ? '' : ' is-last' %>"
                    style="--xp-active: <%= fmt(active) %>; --xp-gap: <%= fmt(gap) %>">
                    <div class="xp-rail" aria-hidden="true">
                        <% yearsIn(role.startMonth, until).forEach(function (tick) { %>
                            <span class="xp-tick" style="--xp-at: <%= fmt(tick.at) %>"><%= tick.year %></span>
                        <% }); %>
                        <% if (role.current) { %>
                            <span class="xp-tick xp-tick-now" style="--xp-at: <%= fmt(active) %>">Now</span>
                        <% } %>
                        <span class="xp-marker"></span>
                        <svg class="xp-wave" data-xp-draw style="--xp-len: <%= fmt(active) %>"
                            viewBox="0 0 <%= WAVE_WIDTH %> <%= fmt(active * UNITS_PER_MONTH) %>" preserveAspectRatio="xMidYMin slice" focusable="false">
                            <path d="<%= wavePath(active, seedOf(role.id), role.current) %>" pathLength="1" />
                        </svg>
                        <% if (gap > 0) { %>
                            <span class="xp-flat" data-xp-draw style="--xp-len: <%= fmt(gap) %>"></span>
                        <% } %>
                        <% if (!next && role.current) { %><span class="xp-cap"></span><% } %>
                        <% if (label) { %><span class="xp-gap-note"><%= label %></span><% } %>
                    </div>
                    <div class="xp-entry">
                        <h3 class="font-display text-2xl font-medium text-ink"><%= role.role %></h3>
                        <p class="mt-1 text-steel"><%= role.company %>, <time datetime="<%= role.start.toISOString().slice(0, 7) %>"><%= role.period %></time></p>
                        <ul class="xp-points">
                            <% role.points.forEach(function (point) { %>
                                <li><span class="xp-point-lead"><%= point.lead %></span><% if (point.rest) { %> <%= point.rest %><% } %></li>
                            <% }); %>
                        </ul>
                    </div>
                </li>
            <% }); %>
        </ol>
    </div>
    <% } %>
</section>
<script type="module" src="/js/sections/experience.js"></script>
