<section id="skills" class="wrap py-24" aria-labelledby="skills-title">
    <h2 id="skills-title" class="heading-section">Skills</h2>
    <div class="mt-12 space-y-10">
        <% skillGroups.forEach(function (group) { %>
            <div>
                <h3 class="font-display text-2xl"><%= group.label %></h3>
                <p class="text-steel"><%= group.summary %></p>
                <ul class="mt-4 flex flex-wrap gap-3">
                    <% group.skills.forEach(function (skill) { %><li id="<%= skill.id %>"><%= skill.name %></li><% }); %>
                </ul>
            </div>
        <% }); %>
    </div>
</section>
