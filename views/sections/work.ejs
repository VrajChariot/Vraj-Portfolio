<section id="work" class="wrap py-24" aria-labelledby="work-title">
    <h2 id="work-title" class="heading-section">Selected work</h2>
    <ol class="mt-12 space-y-12">
        <% projects.forEach(function (project) { %>
            <li id="<%= project.id %>">
                <h3 class="font-display text-3xl"><%= project.name %></h3>
                <% if (project.kind) { %><p class="text-steel"><%= project.kind %></p><% } %>
                <% project.summary.forEach(function (line) { %>
                    <p class="mt-3 max-w-[62ch]"><%= line %></p>
                <% }); %>
                <ul class="mt-4 flex flex-wrap gap-3 text-sm text-steel">
                    <% project.stack.forEach(function (tech) { %><li><%= tech %></li><% }); %>
                </ul>
                <p class="mt-4 flex gap-6">
                    <% if (project.demo) { %><a class="text-ultra underline" href="<%= project.demo %>" target="_blank" rel="noopener">Open live demo</a><% } %>
                    <% if (project.github) { %><a class="text-ultra underline" href="<%= project.github %>" target="_blank" rel="noopener">View source</a><% } %>
                </p>
            </li>
        <% }); %>
    </ol>
</section>
