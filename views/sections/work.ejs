<section id="work" class="wrap py-24 md:py-32" aria-labelledby="work-title">
    <h2 id="work-title" class="heading-section">Selected work</h2>
    <% if (projects.length === 0) { %>
        <p class="mt-10 max-w-[62ch] text-lg text-steel">
            No projects are available right now. <a class="text-ultra underline underline-offset-4" href="<%= profile.links.github %>" target="_blank" rel="noopener">See what I'm building on GitHub</a>.
        </p>
    <% } else { %>
        <ul class="work-index mt-12 md:mt-16" data-work-index>
            <% projects.forEach(function (project, index) {
                const open = index === 0; %>
                <li id="<%= project.id %>" class="work-row<%= open ? ' is-open' : '' %>" data-work-row>
                    <div class="work-row__head">
                        <h3 class="work-row__title">
                            <button type="button" id="<%= project.id %>-toggle" class="work-row__toggle" aria-expanded="<%= open %>" aria-controls="<%= project.id %>-panel" data-cursor="<%= open ? 'Close' : 'Open' %>">
                                <span class="work-row__name"><%= project.name %></span>
                                <% if (project.kind) { %><span class="work-row__kind"><%= project.kind %></span><% } %>
                            </button>
                        </h3>
                        <div class="work-row__meta">
                            <% if (project.flow) { %>
                                <ol class="work-route" aria-label="Request path">
                                    <% project.flow.forEach(function (hop) { %><li><%= hop.label %></li><% }); %>
                                </ol>
                            <% } %>
                            <% if (project.stack.length) { %>
                                <ul class="work-row__stack" aria-label="Built with">
                                    <% project.stack.forEach(function (tech) { %><li><%= tech %></li><% }); %>
                                </ul>
                            <% } %>
                        </div>
                        <span class="work-row__mark" aria-hidden="true"></span>
                    </div>
                    <div id="<%= project.id %>-panel" class="work-panel" role="region" aria-labelledby="<%= project.id %>-toggle">
                        <div class="work-panel__clip">
                            <div class="work-panel__body">
                                <div class="work-panel__summary">
                                    <% project.summary.forEach(function (line) { %><p><%= line %></p><% }); %>
                                </div>
                                <% if (project.demo || project.github) { %>
                                    <p class="work-panel__links">
                                        <% if (project.demo) { %><a href="<%= project.demo %>" target="_blank" rel="noopener">Open live demo</a><% } %>
                                        <% if (project.github) { %><a href="<%= project.github %>" target="_blank" rel="noopener">View source</a><% } %>
                                    </p>
                                <% } %>
                                <% if (project.flow) { %>
                                    <figure class="work-flow" data-flow>
                                        <figcaption class="work-flow__caption">How a request moves through <%= project.name %></figcaption>
                                        <div class="work-flow__track" data-flow-track>
                                            <ol class="work-flow__hops" data-flow-hops>
                                                <% project.flow.forEach(function (hop) { %>
                                                    <li class="work-flow__node" data-flow-node>
                                                        <span class="work-flow__label"><%= hop.label %></span>
                                                        <span class="work-flow__detail"><%= hop.detail %></span>
                                                        <span class="work-flow__ring" data-flow-ring aria-hidden="true"></span>
                                                    </li>
                                                <% }); %>
                                            </ol>
                                            <span class="work-flow__packet" data-flow-packet aria-hidden="true"></span>
                                        </div>
                                    </figure>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </li>
            <% }); %>
        </ul>
        <script type="module" src="/js/sections/work.js"></script>
    <% } %>
</section>
