<section id="contact" class="contact bg-ultra-deep pb-20 pt-28 text-paper md:pb-28 md:pt-40" data-theme="deep" aria-labelledby="contact-title">
    <div class="wrap">
        <h2 id="contact-title" class="heading-section max-w-[20ch]">Building something with LLMs? Tell me what you are working on.</h2>

        <div class="mt-14 flex flex-wrap items-baseline gap-x-6 gap-y-4 md:mt-20">
            <a class="contact-email font-display font-medium" href="mailto:<%= profile.email %>"><%= profile.email %></a>
            <button type="button" class="contact-pill" data-copy-email="<%= profile.email %>" data-magnetic>Copy email</button>
        </div>

        <div class="mt-20 grid gap-16 md:mt-28 md:grid-cols-12">
            <form class="contact-form grid gap-8 md:col-span-7" data-contact-form data-key="<%= profile.contactFormKey %>" data-email="<%= profile.email %>" novalidate>
                <p class="max-w-[52ch] text-ultra-pale">Or send a message here and it lands in my inbox.</p>
                <div class="grid gap-8 sm:grid-cols-2">
                    <div class="contact-field">
                        <label for="contact-name">Name</label>
                        <input id="contact-name" type="text" name="name" autocomplete="name" required>
                    </div>
                    <div class="contact-field">
                        <label for="contact-mail">Email</label>
                        <input id="contact-mail" type="email" name="email" autocomplete="email" required>
                    </div>
                </div>
                <div class="contact-field">
                    <label for="contact-message">Message</label>
                    <textarea id="contact-message" name="message" rows="5" required></textarea>
                </div>
                <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true">
                <div class="flex flex-wrap items-center gap-6">
                    <button type="submit" class="contact-pill contact-pill--solid" data-magnetic>Send message</button>
                    <p class="contact-status text-ultra-pale" role="status" aria-live="polite" data-contact-status></p>
                </div>
            </form>

            <ul class="contact-links grid content-start gap-3 text-xl md:col-span-4 md:col-start-9">
                <li><a href="<%= profile.links.linkedin %>" target="_blank" rel="noopener">LinkedIn</a></li>
                <li><a href="<%= profile.links.github %>" target="_blank" rel="noopener">GitHub</a></li>
                <li><a href="<%= profile.links.cv %>" target="_blank" rel="noopener">Open the CV</a></li>
            </ul>
        </div>
    </div>
</section>
<script type="module" src="/js/sections/contact.js"></script>
